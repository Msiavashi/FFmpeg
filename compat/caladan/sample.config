# FFmpeg antagonist Caladan runtime config.
#
# "be" (best-effort) priority is intentional — the antagonist should be
# preemptible and yieldable so iokernel can demonstrate (or fail to
# demonstrate) contention management against a co-located LC app.

host_addr 192.168.1.5
host_netmask 255.255.255.0
host_gateway 192.168.1.1
runtime_kthreads 4
runtime_guaranteed_kthreads 0
runtime_priority be
